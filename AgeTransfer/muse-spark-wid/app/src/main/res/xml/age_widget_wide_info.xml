<?xml version="1.0" encoding="utf-8"?>
<!-- Wide 4x2 widget (reference wide size) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_desc_wide"
    android:initialLayout="@layout/widget_age"
    android:previewLayout="@layout/widget_age"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="640dp"
    android:maxResizeHeight="320dp"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    android:configure="com.ageinmotion.widget.ConfigActivity"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0" />
