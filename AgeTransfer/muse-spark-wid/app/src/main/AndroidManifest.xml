<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ticks must survive reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- One-tap "don't optimize" dialog (only where the OS offers it). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Real-time engine (foreground service, special-use: live widget). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgeInMotion">

        <!-- Launcher entry + widget configure entry (both widget infos point here). -->
        <activity
            android:name=".ConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.AgeInMotion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Real-time ticking engine. -->
        <service
            android:name=".TickerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live home-screen age ticker. Redraws only while the screen is on and only when a visible digit changes; holds no wake locks." />
        </service>

        <!-- Square 2x2 -->
        <receiver
            android:name=".AgeWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.ageinmotion.widget.ACTION_TICK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/age_widget_info" />
        </receiver>

        <!-- Wide 4x2 -->
        <receiver
            android:name=".AgeWidgetWideProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.ageinmotion.widget.ACTION_TICK" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/age_widget_wide_info" />
        </receiver>
    </application>
</manifest>
